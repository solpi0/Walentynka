<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ważne pytanie 💘</title>

<style>
* { box-sizing: border-box; }

body {
    margin: 0;
    height: 100vh;
    background: radial-gradient(circle at top, #ff9a9e, #ff2f6d, #1a0010);
    overflow: hidden;
    font-family: Arial, sans-serif;
    color: white;
}

/* SERCA */
.heart {
    position: fixed;
    z-index: 1;
    color: rgba(255,255,255,0.25);
    animation: float 12s linear infinite;
    pointer-events: none;
}

@keyframes float {
    from { transform: translateY(110vh) rotate(0deg); }
    to { transform: translateY(-10vh) rotate(360deg); }
}

/* APP */
#app {
    position: relative;
    z-index: 2;
    height: 100%;
}

/* CENTER */
.wrapper {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 20px;
}

/* CARD */
.card {
    background: rgba(0,0,0,0.45);
    backdrop-filter: blur(12px);
    border-radius: 30px;
    padding: 40px 25px;
    max-width: 360px;
    width: 100%;
    box-shadow: 0 0 80px rgba(255,50,120,0.6);
    animation: pop 1.2s ease;
}

@keyframes pop {
    from { transform: scale(0.7); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
}

h1 {
    font-size: 30px;
    animation: pulse 2s infinite;
}

@keyframes pulse {
    0% { text-shadow: 0 0 10px #ff4d6d; }
    50% { text-shadow: 0 0 30px #ff9a9e; }
    100% { text-shadow: 0 0 10px #ff4d6d; }
}

.subtitle {
    opacity: 0.9;
    margin-bottom: 30px;
}

/* BUTTONS */
button {
    border: none;
    border-radius: 16px;
    padding: 16px 26px;
    font-size: 20px;
    cursor: pointer;
}

#yes {
    background: linear-gradient(135deg, #ff4d6d, #ff9a9e);
    color: white;
    box-shadow: 0 0 25px rgba(255,80,120,0.9);
    width: 100%;
}

#no {
    background: rgba(255,255,255,0.2);
    color: white;
    position: fixed;
    z-index: 3;
}

/* FADE */
#app.fade-out {
    animation: fadeOut 0.8s forwards;
}

@keyframes fadeOut {
    to {
        opacity: 0;
        transform: scale(0.9);
        filter: blur(6px);
    }
}

.fade-in {
    animation: fadeIn 1.2s forwards;
}

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: scale(1.1);
        filter: blur(8px);
    }
    to {
        opacity: 1;
        transform: scale(1);
        filter: blur(0);
    }
}

/* FINAL SCREEN */
.final-screen {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: center;
}

.result-box {
    background: rgba(0,0,0,0.6);
    padding: 30px;
    border-radius: 25px;
    text-align: center;
}
</style>
</head>

<body>

<div id="app">
    <div class="wrapper">
        <div class="card">
            <h1>Czy zostaniesz<br>moją walentynką? 💘</h1>
            <div class="subtitle">To pytanie może zmienić wszystko 😌</div>
            <button id="yes">TAK ❤️</button>
        </div>
    </div>
    <button id="no">NIE 🙄</button>
</div>

<script>
// SERCA
for (let i = 0; i < 25; i++) {
    const h = document.createElement("div");
    h.className = "heart";
    h.innerHTML = "❤️";
    h.style.left = Math.random() * 100 + "vw";
    h.style.fontSize = 14 + Math.random() * 30 + "px";
    h.style.animationDuration = 8 + Math.random() * 8 + "s";
    document.body.appendChild(h);
}

// UCIEKAJĄCE NIE
const noBtn = document.getElementById("no");
function moveNo() {
    noBtn.style.left = Math.random() * (window.innerWidth - noBtn.offsetWidth - 20) + "px";
    noBtn.style.top = Math.random() * (window.innerHeight - noBtn.offsetHeight - 20) + "px";
}
setInterval(moveNo, 500);
noBtn.addEventListener("touchstart", moveNo);
moveNo();

// CLICK YES — FINAL
const PHOTO = "ja.jpg"

document.getElementById("yes").addEventListener("click", () => {
    document.getElementById("app").classList.add("fade-out");

    setTimeout(() => {
        const screen = document.createElement("div");
        screen.className = "final-screen fade-in";
        screen.style.backgroundImage = `url('${PHOTO}')`;

        screen.innerHTML = `
            <div class="result-box">
                <h1>WIEDZIAŁEM 😍</h1>
                <p>Oficjalnie: Ty + Ja ❤️14 luty ;))))</p>
            </div>
        `;

        document.body.appendChild(screen);
    }, 800);
});
</script>

</body>
</html>